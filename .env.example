# Copy this file to .env and fill in your values.

# PostgreSQL. Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Redis, used for the BullMQ job queue and the report cache.
REDIS_URL=redis://127.0.0.1:6379

# The app's own public URL, e.g. https://crm.example.com. Behind a proxy the
# request's host header is whatever the proxy forwards, and OAuth redirect URIs
# have to match what is registered with the provider exactly — so set this in
# any deployment. Left empty, the request's own origin is used, which is what
# makes http://localhost:3000 work with no configuration.
PUBLIC_BASE_URL=

# Chat verification codes. Outside production the API returns the code in its
# response — set this to false to stop it, or true to keep it on in production.
# Once a mailbox is connected below, the code is emailed as well.
CHAT_RETURN_AUTH_CODE=

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------

# Encrypts OAuth tokens at rest (a connected mailbox's refresh token). Must
# decode to 32 bytes — generate one with `openssl rand -base64 32`. Rotating it
# makes every stored grant unreadable, so mailboxes have to be reconnected.
SECRET_ENCRYPTION_KEY=

# Signs the session cookie. At least 32 characters; same generator as above.
# Rotating it signs everybody out.
AUTH_SESSION_SECRET=

# -----------------------------------------------------------------------------
# Sending email
# -----------------------------------------------------------------------------

# Which EmailProvider sends: "gmail" or "console". Left empty, Gmail is used
# when it has credentials, and outside production the console provider — which
# logs the message instead of sending it — stands in.
EMAIL_PROVIDER=

# Google OAuth client (Google Cloud console → APIs & Services → Credentials →
# OAuth client ID → Web application), with the Gmail API enabled. Its authorized
# redirect URI must be <PUBLIC_BASE_URL>/api/v1/email/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Signing in
# -----------------------------------------------------------------------------

# Which AuthProvider authenticates CRM users: "auth0" or "dev". Left empty,
# Auth0 is used when it has credentials, and "dev" — which requires no sign-in
# at all — otherwise. "dev" refuses to run in production.
AUTH_PROVIDER=

# Auth0 application of type "Regular Web Application". Its Allowed Callback URL
# must be <PUBLIC_BASE_URL>/api/auth/callback and its Allowed Logout URL
# <PUBLIC_BASE_URL>/. The domain is written bare, e.g. tenant.eu.auth0.com.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Only needed if you also call an Auth0-protected API with the access token.
AUTH0_AUDIENCE=
